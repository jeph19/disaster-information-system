rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function canOperate() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/disaster_users/$(request.auth.uid)).data.role
          in ['Administrator', 'Coordinator'];
    }

    match /incidents/{incidentId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if canOperate()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if canOperate();
    }
  }
}
